{
    "name": "pivotphp/logger",
    "description": "PSR-3 logging implementation for PivotPHP powered by Monolog with multi-channel and telemetry support",
    "type": "library",
    "keywords": [
        "php",
        "logging",
        "psr-3",
        "logger",
        "monolog",
        "pivotphp",
        "opentelemetry"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Caio Alberto Fernandes"
        }
    ],
    "support": {
        "issues": "https://github.com/PivotPHP/pivotphp-logger/issues",
        "source": "https://github.com/PivotPHP/pivotphp-logger"
    },
    "require": {
        "php": ">=8.2",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "PivotPHP\\Logger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PivotPHP\\Logger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress",
        "cs:check": "phpcs --standard=PSR12 src tests",
        "cs:fix": "phpcbf --standard=PSR12 src tests",
        "quality:check": [
            "@phpstan",
            "@cs:check",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
